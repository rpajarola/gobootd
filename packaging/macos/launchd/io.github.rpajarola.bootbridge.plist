<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.rpajarola.bootbridge</string>
	<key>ProgramArguments</key>
	<array><string>/usr/local/bin/bootbridge</string><string>-c</string><string>/usr/local/etc/bootbridge.hcl</string></array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/bootbridge.log</string>
</dict>
</plist>
